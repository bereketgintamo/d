# ============================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================================

# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# FIREBASE ADMIN CONFIGURATION
# Choose ONE of the following methods:
# ============================================================

# Method 1: Paste your Firebase Service Account JSON directly (recommended for deployment)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# IMPORTANT: Remove all newlines from the JSON when pasting here
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"..."}

# Method 2: Path to Firebase Service Account JSON file (recommended for local development)
# Place your firebase-service-account.json file in the project directory
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000

# ============================================================
# NOTES
# ============================================================
# 1. For production deployment (Render/Railway), use FIREBASE_SERVICE_ACCOUNT_JSON
# 2. For local development, use FIREBASE_SERVICE_ACCOUNT_PATH
# 3. Never commit your .env file to version control
# 4. Keep your SUPABASE_SERVICE_ROLE_KEY secret - it has full database access